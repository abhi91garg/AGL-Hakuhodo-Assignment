PORT=4000
LOG_LEVEL=log
DATABASE_PATH=./data/nhtsa.sqlite
NHTSA_MAKES_URL=https://vpic.nhtsa.dot.gov/api/vehicles/getallmakes?format=XML
NHTSA_TYPES_URL=https://vpic.nhtsa.dot.gov/api/vehicles/GetVehicleTypesForMakeId
NHTSA_MAX_CONCURRENCY=5
NHTSA_REQUEST_TIMEOUT_MS=10000
NHTSA_MAX_RETRIES=2
NHTSA_RETRY_BASE_DELAY_MS=500
NHTSA_RETRY_MAX_DELAY_MS=5000
